# Copy to .env. These are inlined into the Worker bundle at build time by esbuild.config.mjs,
# so changing any of them requires a rebuild + redeploy, not a `wrangler secret put`.
#
# An EMPTY value means "feature disabled" and is always a safe state.

# --- Domains this deployment serves ---
# Hostnames that should render X/Twitter, Bluesky, TikTok and Instagram embeds respectively.
# Only set a list if you actually own and route those hostnames to this Worker.

STANDARD_DOMAIN_LIST = "e.puppygirl.city"
STANDARD_BSKY_DOMAIN_LIST = ""
STANDARD_TIKTOK_DOMAIN_LIST = ""
STANDARD_INSTAGRAM_DOMAIN_LIST = ""

# --- Subdomain feature flags ---
# Each entry needs its own DNS record and Worker route. Leave empty unless you have provisioned
# them; an unresolvable hostname here simply never matches.

DIRECT_MEDIA_DOMAINS = ""
TEXT_ONLY_DOMAINS = ""
INSTANT_VIEW_DOMAINS = ""
GALLERY_DOMAINS = ""
FORCE_MOSAIC_DOMAINS = ""
OLD_EMBED_DOMAINS = ""

# --- External microservices ---
#
# IMPORTANT: these are NOT this Worker. Upstream FxEmbed runs each as a separate deployment
# (an image compositor, a GIF/video transcoder, an image proxy). If you do not run them, leave
# these EMPTY.
#
# Setting them to a hostname that does not resolve is worse than leaving them blank: the Worker
# will rewrite media URLs onto that host, and every image, GIF and video embed will break.
#
# With them empty, media links straight to the upstream CDN, which is what Discord wants:
#   - no mosaic         -> multiple images emit multiple attachments / og:image tags
#   - no GIF transcode  -> GIFs emit the mp4, which Discord renders as an auto-looping player
#   - no PBS proxy      -> photos link directly to pbs.twimg.com

MOSAIC_DOMAIN_LIST = ""
MOSAIC_BSKY_DOMAIN_LIST = ""
GIF_TRANSCODE_DOMAIN_LIST = ""
VIDEO_TRANSCODE_DOMAIN_LIST = ""
VIDEO_TRANSCODE_BSKY_DOMAIN_LIST = ""
PBS_PROXY_DOMAIN_LIST = ""

# Translation service (also external). Requires a token to do anything.
POLYGLOT_DOMAIN_LIST = ""
POLYGLOT_ACCESS_TOKEN = ""

# --- API hosts ---
# Hostnames that should serve the JSON API instead of embeds. Empty disables the API realm.
# A non-empty value also routes video embeds through a `https://<host>/2/go?url=` redirect hop,
# so only set this to a hostname that is actually routed to this Worker.

API_HOST_LIST = ""
BLUESKY_API_HOST_LIST = ""
ATMOSPHERE_API_HOST_LIST = ""

# --- Upstream roots ---

TWITTER_ROOT = "https://x.com"
INSTAGRAM_ROOT = "https://www.instagram.com"

# --- Observability (optional) ---

SENTRY_DSN = ""
SENTRY_AUTH_TOKEN = ""
SENTRY_ORG = ""
SENTRY_PROJECT = ""
